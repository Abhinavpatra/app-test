<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml for why every domain is excluded.
     The encrypted database is useless without its Keystore key, so shipping it
     to a new device would produce an unopenable file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
