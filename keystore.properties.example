# Copy to `keystore.properties` (gitignored — never commit the real one) and fill in.
# Generate a key with:
#   keytool -genkeypair -v -keystore bloom-release.jks -alias bloom -keyalg RSA -keysize 2048 -validity 10000
# Without the real file, release builds still compile (including R8) but stay unsigned.
storeFile=/absolute/path/to/bloom-release.jks
storePassword=change-me
keyAlias=bloom
keyPassword=change-me
